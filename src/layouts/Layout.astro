---
import "../styles/global.css";
const {
  title = "GameWire — Gaming News",
  description = "Fast, independent gaming news covering games, updates, hardware and the biggest stories.",
  canonical,
  image = "/GameWire/images/og.svg",
  type = "website",
  publishedAt,
  updatedAt,
  author = "GameWire Staff",
  breadcrumbs = []
} = Astro.props;

const site = "https://example.github.io/gamewire";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const absoluteImage = image.startsWith("http") ? image : `${site}${image}`;
const robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="GameWire RSS" href={`${site}/rss.xml`} />
  <link rel="sitemap" type="application/xml" href={`${site}/sitemap-index.xml`} />
  <meta name="theme-color" content="#090909" />
  <meta property="og:site_name" content="GameWire" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  {publishedAt && <meta property="article:published_time" content={publishedAt} />}
  {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
  {author && <meta name="author" content={author} />}
  <title>{title}</title>
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a class="logo" href="/GameWire/" aria-label="GameWire home">GAME<span>WIRE</span></a>
      <nav aria-label="Primary navigation">
        <a href="/GameWire/news/">News</a>
        <a href="/GameWire/games/">Games</a>
        <a href="/GameWire/categories/">Categories</a>
        <a href="/GameWire/platforms/">Platforms</a>
      </nav>
      <a class="search-link" href="/GameWire/search/">⌕ Search</a>
    </div>
  </header>
  <main>
    {breadcrumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbs.map((b, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {b.url ? <a href={b.url}>{b.label}</a> : <span>{b.label}</span>}
          </>
        ))}
      </nav>
    )}
    <slot />
  </main>
  <footer class="footer">
    <div class="footer-grid">
      <div><a class="logo" href="/GameWire/">GAME<span>WIRE</span></a><p>Independent gaming coverage, automatically organized and built for speed.</p></div>
      <div><strong>Explore</strong><a href="/GameWire/news/">Latest News</a><a href="/GameWire/games/">Games</a><a href="/GameWire/categories/">Categories</a></div>
      <div><strong>Information</strong><a href="/GameWire/about/">About</a><a href="/GameWire/contact/">Contact</a><a href="/GameWire/privacy/">Privacy</a></div>
    </div>
    <div class="footer-bottom">© 2026 GameWire · Built with Astro + GitHub Pages</div>
  </footer>
</body>
</html>