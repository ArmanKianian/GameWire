---
import "../styles/global.css";
const {
  title = "GameWire — Gaming News",
  description = "Fast, independent gaming news covering games, updates, hardware and the biggest stories.",
  canonical,
  image = "/GameWire/images/og.svg",
  type = "website",
  publishedAt,
  updatedAt,
  author = "GameWire Staff",
  breadcrumbs = []
} = Astro.props;

const site = "https://example.github.io/gamewire";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const absoluteImage = image.startsWith("http") ? image : `${site}${image}`;
const robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="GameWire RSS" href={`${site}/rss.xml`} />
  <link rel="sitemap" type="application/xml" href={`${site}/sitemap-index.xml`} />
  <meta name="theme-color" content="#090909" />
  <meta property="og:site_name" content="GameWire" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  {publishedAt && <meta property="article:published_time" content={publishedAt} />}
  {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
  {author && <meta name="author" content={author} />}
  <title>{title}</title>
</head>
<body class="bg-[radial-gradient(circle_at_75%_0,#24150d_0,#090909_34%)] font-sans text-[#eee] text-gray-100 scroll-smooth selection:bg-yellow-500/30">
  <header class="sticky top-0 z-20 border-b border-[#242424] bg-[#090909e8] backdrop-blur-[18px]">
    <div class="max-w-[1400px] h-[72px] mx-auto px-[5vw] flex items-center gap-[42px]">
      <a href="/GameWire/" aria-label="GameWire home" class="text-xl font-extralight tracking-tight">
        GAME<span class="text-yellow-500">WIRE</span></a>
      <nav aria-label="Primary navigation" class="hidden md:flex gap-6 text-gray-400 text-sm">
        <a href="/GameWire/news/">News</a>
        <a href="/GameWire/games/">Games</a>
        <a href="/GameWire/categories/">Categories</a>
        <a href="/GameWire/platforms/">Platforms</a>
      </nav>
      <a href="/GameWire/search/" class="ml-auto text-gray-500 hover:text-white">⌕ Search</a>
    </div>
  </header>
  <main class="min-h-[65vh]">
    {breadcrumbs.length > 0 && (
      <nav class="max-w-[1200px] mx-auto mt-7 px-[5vw] flex gap-2.5 text-gray-500 text-[0.78rem] flex-wrap" aria-label="Breadcrumb">
        {breadcrumbs.map((b, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {b.url ? <a href={b.url}>{b.label}</a> : <span>{b.label}</span>}
          </>
        ))}
      </nav>
    )}
    <slot />
  </main>
  <footer class="border-t border-[#242424] bg-[#090909] mt-20">
    <div class="max-w-[1400px] mx-auto px-[5vw] py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <a href="/GameWire/" class="font-extralight tracking-tight text-xl">GAME<span class="text-yellow-500">WIRE</span></a>
        <p class="text-gray-500 mt-4 text-sm max-w-xs">Independent gaming coverage, automatically organized and built for speed.</p>
      </div>
      <div>
        <strong class="text-gray-300">Explore</strong>
        <div class="flex flex-col gap-4 mt-4 text-sm text-gray-400">
          <a href="/GameWire/news/">Latest News</a>
          <a href="/GameWire/games/">Games</a>
          <a href="/GameWire/categories/">Categories</a>
        </div>
      </div>
      <div>
        <strong class="text-gray-300">Information</strong>
        <div class="flex flex-col gap-4 mt-4 text-sm text-gray-400">
          <a href="/GameWire/about/">About</a>
          <a href="/GameWire/contact/">Contact</a>
          <a href="/GameWire/privacy/">Privacy</a>
        </div>
      </div>
    </div>
    <div class="max-w-[1400px] mx-auto px-[5vw] py-6 text-center text-gray-600 text-sm">
      © 2026 GameWire · Built with Astro + GitHub Pages
    </div>
  </footer>
</body>
</html>