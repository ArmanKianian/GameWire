---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import JsonLd from "../components/JsonLd.astro";
import articles from "../data/articles.json";

const sorted = [...articles].sort((a,b) => new Date(b.publishedAt) - new Date(a.publishedAt));
const hero = sorted[0];
const latest = sorted.slice(1, 10);
const popular = sorted.slice(10, 14);
const site = "https://example.github.io/gamewire";
const schema = {
  "@context":"https://schema.org",
  "@type":"WebSite",
  "name":"GameWire",
  "url":site,
  "description":"Fast, independent gaming news.",
  "potentialAction":{"@type":"SearchAction","target":`${site}/search/?q={search_term_string}`,"query-input":"required name=search_term_string"}
};
---
<Layout title="GameWire — Gaming News, Updates & Stories" description="The latest gaming news, updates, releases and hardware stories across PC, PlayStation, Xbox and Nintendo.">
  <JsonLd data={schema} />
  <section class="hero">
    <div>
      <p class="eyebrow">⚡ THE GAMING FEED</p>
      <h1>Gaming news.<br /><em>Without the noise.</em></h1>
      <p class="hero-lead">The latest stories, updates and announcements across PC, PlayStation, Xbox and Nintendo — organized in one fast place.</p>
      <div class="hero-actions"><a class="button" href="/gamewire/news/">Explore latest news</a><a class="button ghost" href="/gamewire/games/">Browse games</a></div>
    </div>
    <ArticleCard article={hero} featured />
  </section>

  <section class="section">
    <div class="section-head"><div><p class="eyebrow">LATEST</p><h2>What's happening</h2></div><a href="/gamewire/news/">View all →</a></div>
    <div class="news-grid">{latest.map(a => <ArticleCard article={a} />)}</div>
  </section>

  <section class="section">
    <div class="section-head"><div><p class="eyebrow">DISCOVER</p><h2>Trending games</h2></div><a href="/gamewire/games/">All games →</a></div>
    <div class="game-grid">
      {[...new Set(popular.map(a => a.game))].map(game => <a class="game-tile" href={`/gamewire/games/${game.toLowerCase().replaceAll(" ","-")}/`}><span>🎮</span><strong>{game}</strong><small>Latest coverage →</small></a>)}
    </div>
  </section>

  <section class="pipeline">
    <div><b>01</b><strong>Sources</strong><span>RSS & trusted feeds</span></div>
    <div><b>02</b><strong>Organize</strong><span>Deduplicate & classify</span></div>
    <div><b>03</b><strong>Build</strong><span>Static SEO pages</span></div>
    <div><b>04</b><strong>Deploy</strong><span>GitHub Pages</span></div>
  </section>
</Layout>