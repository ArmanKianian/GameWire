---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import articles from "../../data/articles.json";
const sorted = [...articles].sort((a,b) => new Date(b.publishedAt) - new Date(a.publishedAt));
---
<Layout title="Latest Gaming News — GameWire" description="Browse the latest gaming news, updates, announcements and stories.">
  <section class="listing">
    <p class="eyebrow">NEWSROOM</p><h1>Latest gaming news</h1><p class="intro">Fresh gaming stories, organized by game, category and platform.</p>
    <div class="news-grid">{sorted.map(a => <ArticleCard article={a} />)}</div>
  </section>
</Layout>