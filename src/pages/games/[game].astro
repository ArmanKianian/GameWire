---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import articles from "../../data/articles.json";
export function getStaticPaths() {
  return [...new Set(articles.map(a=>a.game))].map(game=>({params:{game:game.toLowerCase().replaceAll(" ","-")},props:{game}}));
}
const {game}=Astro.props;
const items=articles.filter(a=>a.game===game).sort((a,b)=>new Date(b.publishedAt)-new Date(a.publishedAt));
const studio=items[0]?.studio ?? "Game studio";
---
<Layout title={`${game} News & Updates — GameWire`} description={`The latest ${game} news, updates, announcements and coverage from GameWire.`} breadcrumbs={[{label:"Home",url:"/GameWire/"},{label:"Games",url:"/GameWire/games/"},{label:game}]}>
  <section class="listing"><p class="eyebrow">GAME</p><h1>{game}</h1><p class="intro">{studio} · Latest news, updates and stories.</p><div class="news-grid">{items.map(a=><ArticleCard article={a}/>)}</div></section>
</Layout>