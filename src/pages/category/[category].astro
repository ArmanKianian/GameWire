---
import Layout from "../../layouts/Layout.astro";
import articles from "../../data/articles.json";

export function getStaticPaths() {
  return ["gaming", "rpg", "hardware"].map((category) => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.props;
const items = articles.filter((a) => a.category.toLowerCase() === category);
---
<Layout title={`${category} News — GameWire`}>
  <div class="category-page">
    <p class="eyebrow">CATEGORY</p>
    <h1>{category}</h1>
    <div class="grid">
      {items.map((article) => (
        <article class="card">
          <img src={article.image} alt="" loading="lazy" />
          <div class="card-body">
            <div class="meta"><b>{article.game}</b><span>{new Date(article.publishedAt).toLocaleDateString()}</span></div>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <a href={article.url}>Read story →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>