---
const { article, featured = false } = Astro.props;
---

<article class:list={["bg-[#111] border border-[#222] rounded-[14px] overflow-hidden hover:-translate-y-[4px] hover:border-[#444] transition-all duration-200", { featured }]}>
  <a href={`/GameWire/news/${article.slug}/`} class="block">
    <img src={article.image} alt={`${article.game} — ${article.title}`} loading="lazy" width="1200" height="675" class="w-full h-auto block" />
  </a>
  <div class="p-6">
    <div class="flex items-center justify-between gap-3 mb-3">
      <a href={`/GameWire/categories/${article.category.toLowerCase().replaceAll(" ", "-")}/`} class="text-[0.9rem] text-gray-400 hover:text-white">{article.category}</a>
      <time class="text-[0.85rem] text-gray-600">{new Date(article.publishedAt).toLocaleDateString("en-US", {month:"short", day:"numeric", year:"numeric"})}</time>
    </div>
    <h2 class="text-2xl font-light tracking-tight mb-2">{article.title}</h2>
    <p class="text-gray-400 text-sm leading-relaxed mb-4">{article.excerpt}</p>
    <a href={`/GameWire/news/${article.slug}/`} class="text-sm font-medium text-yellow-500 hover:text-white inline-flex items-center gap-1.5">Read story →</a>
  </div>
</article>